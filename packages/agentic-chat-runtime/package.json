{
	"name": "@buildos/agentic-chat-runtime",
	"version": "0.1.0",
	"private": true,
	"description": "Deterministic, host-neutral semantics and shared read tools for BuildOS agentic chat",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./loop": {
			"types": "./dist/loop/index.d.ts",
			"import": "./dist/loop/index.mjs",
			"require": "./dist/loop/index.js"
		},
		"./context": {
			"types": "./dist/context/index.d.ts",
			"import": "./dist/context/index.mjs",
			"require": "./dist/context/index.js"
		},
		"./supervisor": {
			"types": "./dist/supervisor/index.d.ts",
			"import": "./dist/supervisor/index.mjs",
			"require": "./dist/supervisor/index.js"
		},
		"./tools": {
			"types": "./dist/tools/index.d.ts",
			"import": "./dist/tools/index.mjs",
			"require": "./dist/tools/index.js"
		},
		"./tools/milestone-state": {
			"types": "./dist/tools/milestone-state.d.ts",
			"import": "./dist/tools/milestone-state.mjs",
			"require": "./dist/tools/milestone-state.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts src/context/index.ts src/loop/index.ts src/supervisor/index.ts src/tools/index.ts src/tools/milestone-state.ts --format cjs,esm --dts --sourcemap",
		"build:types": "tsup src/index.ts src/context/index.ts src/loop/index.ts src/supervisor/index.ts src/tools/index.ts src/tools/milestone-state.ts --format cjs,esm --dts --sourcemap",
		"clean": "rm -rf dist .turbo",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@buildos/shared-agent-ops": "workspace:*",
		"@buildos/shared-types": "workspace:*",
		"@supabase/supabase-js": "^2.89.0"
	},
	"devDependencies": {
		"@types/node": "^20.11.10",
		"tsup": "^8.3.5",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	}
}
