{
	"name": "@buildos/agent-orchestrator",
	"version": "0.0.0",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist .turbo",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^20.11.10",
		"@vitest/coverage-v8": "^3.2.4",
		"tsup": "^8.3.5",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	}
}
