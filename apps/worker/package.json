{
	"name": "@buildos/worker",
	"version": "1.0.0",
	"description": "General background queues and the dedicated Agentic Chat worker service",
	"main": "dist/index.js",
	"scripts": {
		"build": "node ./node_modules/@typescript/native/bin/tsc",
		"start": "node dist/index.js",
		"start:chat": "node dist/chat-worker.js",
		"dev": "NODE_OPTIONS=\"$NODE_OPTIONS --conditions=development\" tsx watch src/index.ts",
		"dev:chat": "NODE_OPTIONS=\"$NODE_OPTIONS --conditions=development\" tsx watch src/chat-worker.ts",
		"worker": "NODE_OPTIONS=\"$NODE_OPTIONS --conditions=development\" tsx watch src/worker.ts",
		"scheduler": "tsx watch src/scheduler.ts",
		"lint": "eslint \"src/**/*.ts\" && pnpm run guardrails:http-modules",
		"lint:fix": "eslint \"src/**/*.ts\" --fix && pnpm run guardrails:http-modules",
		"typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
		"typecheck:tests": "node ../../scripts/testing/check-test-types.mjs --workspace worker",
		"typecheck:phase-a": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.phase-a.json --noEmit",
		"check": "pnpm run lint && pnpm run typecheck",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:scheduler": "vitest run tests/scheduler.test.ts",
		"test:integration": "vitest run tests/integration",
		"test:deep-research:integration": "vitest run --config vitest.integration.config.ts",
		"test:phase-a-workflow": "AGENTIC_PHASE_A_WORKFLOW=true vitest run tests/phase-a/phaseAWorkflowEval.test.ts --retry=0",
		"guardrails:http-modules": "node ./scripts/check-worker-http-module-size.cjs",
		"backfill:start-here": "tsx src/scripts/backfillStartHereDocuments.ts",
		"cycles:backfill-daily-brief": "tsx src/scripts/backfillDailyBriefCycles.ts",
		"cycles:shadow-daily-brief": "tsx src/scripts/reportDailyBriefCycleShadow.ts",
		"cost-reconciliation:report": "tsx src/scripts/reportAgentRunCostReconciliation.ts"
	},
	"dependencies": {
		"@breezystack/lamejs": "^1.2.7",
		"@buildos/agentic-chat-runtime": "workspace:*",
		"@buildos/shared-agent-ops": "workspace:*",
		"@buildos/shared-types": "workspace:*",
		"@buildos/shared-utils": "workspace:*",
		"@buildos/smart-llm": "workspace:*",
		"@buildos/supabase-client": "workspace:*",
		"@buildos/twilio-service": "workspace:*",
		"@supabase/supabase-js": "^2.89.0",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"dotenv": "^16.3.1",
		"express": "^4.21.2",
		"kokoro-js": "^1.2.1",
		"marked": "^16.3.0",
		"node-cron": "^3.0.3",
		"posthog-node": "^5.39.2",
		"sanitize-html": "^2.17.5",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.32.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^20.9.0",
		"@types/node-cron": "^3.0.11",
		"@types/sanitize-html": "^2.16.0",
		"@types/web-push": "^3.6.4",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^3.2.4",
		"eslint": "^9.32.0",
		"globals": "^16.3.0",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
