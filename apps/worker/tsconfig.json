{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node20",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"removeComments": false,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node"],
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": ["src/**/*", "+server.ts"],
	// Co-located unit tests are typechecked by tsconfig.tests.json (typecheck:tests),
	// which overrides this exclude; they must not compile into dist for Railway.
	"exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
