{
	"name": "@buildos/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS='--max-http-header-size=65536' vite dev",
		"dev:host": "NODE_OPTIONS='--max-http-header-size=65536' vite dev --host",
		"dev:clean": "rm -rf .svelte-kit node_modules/.vite && pnpm run dev",
		"dev:split": "concurrently \"pnpm run dev\" \"pnpm run check:watch\"",
		"build:deps": "pnpm --filter @buildos/web^... build",
		"build": "pnpm run build:deps && pnpm run styles:sync && pnpm run gen:blog-context && pnpm run gen:sitemap && svelte-kit sync && vite build",
		"build:prod": "pnpm run styles:sync && svelte-kit sync && NODE_ENV=production vite build",
		"build:analyze": "ANALYZE=true vite build",
		"preview": "vite preview",
		"preview:host": "vite preview --host",
		"profile:agent-chat-timeline": "vite-node scripts/profile-agent-chat-timeline.ts",
		"check": "svelte-kit sync && NODE_OPTIONS='--max-old-space-size=8192' svelte-check",
		"check:watch": "svelte-kit sync && NODE_OPTIONS='--max-old-space-size=8192' svelte-check --watch",
		"typecheck": "pnpm run check",
		"typecheck:tests": "svelte-kit sync && node ../../scripts/testing/check-test-types.mjs --workspace web",
		"typecheck:phase-a": "tsc -p tsconfig.phase-a.json --noEmit",
		"format": "prettier --write .",
		"guardrails:server-routes": "node ./scripts/check-server-route-size.cjs",
		"guardrails:onto-project-columns": "node ./scripts/check-onto-project-select-columns.cjs",
		"guardrails:supabase-selects": "node ./scripts/check-supabase-select-guardrails.cjs",
		"guardrails:lucide-icons": "node ./scripts/check-lucide-wrapper-exports.cjs",
		"guardrails:styles": "node ./scripts/sync-inkprint-design-library.mjs --check && node ./scripts/check-style-contracts.mjs",
		"guardrails:agent-skills": "vite-node --mode test scripts/check-agent-skills.ts",
		"guardrails:local-skills": "node ./scripts/check-local-skill-frontmatter.mjs",
		"agent-skills:check": "pnpm run guardrails:agent-skills",
		"agent-skills:check:strict": "vite-node --mode test scripts/check-agent-skills.ts --strict",
		"lint": "node ./scripts/run-eslint.cjs && pnpm run guardrails:server-routes && pnpm run guardrails:onto-project-columns && pnpm run guardrails:supabase-selects && pnpm run guardrails:lucide-icons && pnpm run guardrails:styles && pnpm run guardrails:agent-skills && pnpm run guardrails:local-skills",
		"lint:fix": "node ./scripts/run-eslint.cjs --fix && pnpm run styles:sync && pnpm run guardrails:server-routes && pnpm run guardrails:onto-project-columns && pnpm run guardrails:supabase-selects && pnpm run guardrails:lucide-icons && pnpm run guardrails:styles && pnpm run guardrails:agent-skills && pnpm run guardrails:local-skills && pnpm run format",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:llm": "vitest run --config vitest.config.llm.ts",
		"test:llm:watch": "vitest --config vitest.config.llm.ts",
		"test:agentic": "vitest run --config vitest.config.agentic.ts",
		"test:agentic:phase0-evidence": "AGENTIC_PHASE0_CAPTURE=true AGENTIC_ASSERT_TELEMETRY=true AGENTIC_PHASE0_REPETITIONS=3 AGENTIC_E2E_RUN_LABEL=phase0 AGENTIC_SCENARIOS=restraint-noop-and-ambiguity,task-multi-update,task-reschedule-cold-reference,research-turn-finalizes,research-log-readback,task-complete-cold-reference,project-organize,project-catchup-cold vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/__tests__/agentic-scenarios.test.ts --retry=0",
		"test:agentic:battery": "AGENTIC_BATTERY=cedar-house AGENTIC_E2E_RETRY_COUNT=0 AGENTIC_E2E_RUN_LABEL=cedar-house vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/__tests__/agentic-scenarios.test.ts --retry=0",
		"test:agentic:book": "AGENTIC_SCENARIOS=book-writing-journey vitest run --config vitest.config.agentic.ts",
		"test:agentic:phase-a-control": "AGENTIC_PHASE_A_CONTROL=true vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/phase-a/phase-a-control.test.ts",
		"test:agentic:phase-a-control-a2": "AGENTIC_PHASE_A_CONTROL=true AGENTIC_PHASE_A_CONTROL_MODE=a2-complex vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/phase-a/phase-a-control.test.ts --retry=0",
		"test:agentic:phase-a-route": "AGENTIC_PHASE_A_ROUTE_EVAL=true vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/phase-a/route-mode-eval.test.ts",
		"test:agentic:phase-a-route-mitigation-v2": "AGENTIC_PHASE_A_ROUTE_EVAL=true PHASE_A_ROUTE_STRATEGY=fast_then_review PHASE_A_ROUTE_MODEL=google/gemini-3.1-flash-lite PHASE_A_ROUTE_PROFILE=fast PHASE_A_ROUTE_REVIEW_MODEL=z-ai/glm-5.2 PHASE_A_ROUTE_REVIEW_PROFILE=powerful PHASE_A_ROUTE_OUTPUT_PATH=/tmp/buildos-phase-a-route-mitigation-v2.json vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/phase-a/route-mode-eval.test.ts --retry=0",
		"test:agentic:phase-a-route-holdout": "PHASE_A_ROUTE_CORPUS=phase-a-holdout.json AGENTIC_PHASE_A_ROUTE_EVAL=true PHASE_A_ROUTE_STRATEGY=fast_then_review PHASE_A_ROUTE_MODEL=google/gemini-3.1-flash-lite PHASE_A_ROUTE_PROFILE=fast PHASE_A_ROUTE_REVIEW_MODEL=z-ai/glm-5.2 PHASE_A_ROUTE_REVIEW_PROFILE=powerful PHASE_A_ROUTE_RUNS_PER_SCENARIO=3 PHASE_A_ROUTE_OUTPUT_PATH=/tmp/buildos-phase-a-route-holdout-v1.json vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/phase-a/route-mode-eval.test.ts --retry=0",
		"test:agentic:watch": "vitest --config vitest.config.agentic.ts",
		"test:agentic:project-create:worker": "AGENTIC_SCENARIOS=project-create-contract vitest run --config vitest.config.agentic.ts src/lib/tests/agentic-e2e/__tests__/agentic-scenarios.test.ts --retry=0",
		"test:agentic:modal": "playwright test --config playwright.config.agentic.ts",
		"test:agentic:modal:wiring": "playwright test --config playwright.config.agentic.ts --grep @wiring",
		"test:agentic:modal:live": "playwright test --config playwright.config.agentic.ts --grep @live",
		"compare:agentic-evidence": "node scripts/agentic-e2e/compare-evidence.mjs",
		"agentic:health": "node scripts/agentic-health/index.mjs",
		"gen:embeddings": "node --import tsx scripts/generate-embeddings.ts",
		"gen:sctx": "node --import tsx scripts/generateStreamlinedProjectContext.ts . -o ./docs/development/sproject-context.json",
		"gen:blog-context": "node --import tsx scripts/generate-blog-context.ts",
		"gen:sitemap": "node --import tsx scripts/generate-sitemap.ts",
		"gen:web": "pnpm run gen:blog-context && pnpm run gen:sitemap && pnpm run gen:sctx",
		"gen:api-docs": "node --import tsx scripts/generate-api-docs.ts",
		"cleanup:archived-doc-structure": "node --import tsx scripts/cleanup-archived-doc-structure.ts",
		"calendar:migrate-connections": "vite-node --config scripts/vite-node.config.ts --mode production scripts/migrate-legacy-calendar-connections.ts",
		"gen:route-docs": "node --import tsx scripts/generate-route-docs.ts",
		"docs:api": "pnpm run gen:api-docs && pnpm run gen:route-docs",
		"docs:serve": "vite preview --open /docs/api",
		"report:agentic-tools": "vite-node scripts/report-agentic-tool-surface-sizes.ts",
		"analyze:codebase": "node --import tsx scripts/analyze-codebase.ts",
		"mcp:repro": "node scripts/mcp-connector-repro.mjs",
		"generate-configs": "node --import tsx scripts/generate-field-configs.ts",
		"styles:sync": "node ./scripts/sync-inkprint-design-library.mjs",
		"clean": "rm -rf .svelte-kit build node_modules/.vite .tsbuildinfo",
		"clean:all": "pnpm run clean && rm -rf node_modules"
	},
	"devDependencies": {
		"@babel/parser": "^7.28.0",
		"@babel/traverse": "^7.28.0",
		"@babel/types": "^7.28.0",
		"@buildos/agent-orchestrator": "workspace:*",
		"@eslint/compat": "^1.3.1",
		"@eslint/js": "^9.32.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/svelte": "^5.2.8",
		"@types/cytoscape-dagre": "^2.3.4",
		"@types/dom-speech-recognition": "^0.0.7",
		"@types/node": "^20.19.0",
		"@types/nodemailer": "^7.0.1",
		"@types/sanitize-html": "^2.16.0",
		"@types/turndown": "^5.0.6",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.2.0",
		"dotenv": "^17.2.1",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^10.0.8",
		"eslint-plugin-svelte": "^3.11.0",
		"fast-glob": "^3.3.3",
		"globals": "^16.3.0",
		"mdsvex": "^0.12.6",
		"postcss": "^8.5.23",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.0",
		"remark-toc": "^9.0.0",
		"rollup-plugin-visualizer": "^6.0.3",
		"svelte": "^5.53.5",
		"svelte-check": "^4.3.0",
		"svelte-eslint-parser": "^1.4.1",
		"tailwindcss": "^3.4.0",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2",
		"vite": "^7.3.2",
		"vite-node": "3.2.4",
		"vite-plugin-compression": "^0.5.1",
		"vitest": "^3.2.4",
		"yaml": "^2.3.4"
	},
	"engines": {
		"node": ">=20.19.0",
		"pnpm": ">=9.0.0"
	},
	"dependencies": {
		"@ambientcss/css": "3.0.1",
		"@antv/g6": "^5.0.50",
		"@buildos/agentic-chat-runtime": "workspace:*",
		"@buildos/shared-agent-ops": "workspace:*",
		"@buildos/shared-types": "workspace:*",
		"@buildos/shared-utils": "workspace:*",
		"@buildos/smart-llm": "workspace:*",
		"@buildos/supabase-client": "workspace:*",
		"@buildos/twilio-service": "workspace:*",
		"@codemirror/autocomplete": "6.20.0",
		"@codemirror/commands": "6.10.2",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-html": "6.4.11",
		"@codemirror/lang-javascript": "6.2.4",
		"@codemirror/lang-markdown": "6.5.0",
		"@codemirror/language": "6.12.1",
		"@codemirror/lint": "6.9.3",
		"@codemirror/search": "6.6.0",
		"@codemirror/state": "6.5.4",
		"@codemirror/view": "6.39.12",
		"@dagrejs/dagre": "^1.1.8",
		"@lezer/common": "1.5.1",
		"@lezer/highlight": "^1.2.3",
		"@modelcontextprotocol/server": "2.0.0",
		"@supabase/supabase-js": "^2.89.0",
		"@tiptap/core": "^3.0.9",
		"@tiptap/extension-color": "^3.0.9",
		"@tiptap/extension-image": "^3.0.9",
		"@tiptap/extension-link": "^3.0.9",
		"@tiptap/extension-text-align": "^3.0.9",
		"@tiptap/extension-text-style": "^3.0.9",
		"@tiptap/starter-kit": "^3.0.9",
		"@vercel/analytics": "^2.0.1",
		"@vercel/functions": "3.9.5",
		"@vercel/speed-insights": "^2.0.0",
		"@xyflow/svelte": "^1.5.0",
		"cytoscape": "^3.33.1",
		"cytoscape-cola": "^2.5.1",
