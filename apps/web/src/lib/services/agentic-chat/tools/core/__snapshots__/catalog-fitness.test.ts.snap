    {
      "name": "create_onto_document",
      "serialized": "{"type":"function","function":{"name":"create_onto_document","description":"Create a project document such as a brief, spec, context note, research artifact, or creative reference. Use parent_id for tree placement.","parameters":{"type":"object","properties":{"project_id":{"type":"string","description":"Project UUID"},"title":{"type":"string","description":"Document title"},"description":{"type":"string","description":"Short document summary"},"type_key":{"type":"string","default":"document.default","description":"Document type taxonomy (required): document.{family}[.{variant}]\\nFamilies: context (project/brief), knowledge (research), notes (meeting_notes/rfc), spec (product/technical), reference (handbook/sop), intake (client/project), creative (structure/character/world/chapter).\\nExamples: document.context.project, document.knowledge.research, document.spec.technical, document.creative.character"},"state_key":{"type":"string","enum":["draft","in_review","ready","published","archived"],"description":"Document state.","default":"draft"},"content":{"type":"string","description":"Markdown body content stored in the content column"},"props":{"type":"object","description":"Additional properties/metadata"},"parent_id":{"type":["string","null"],"description":"Parent document ID to place this document under in the tree hierarchy. Null or omitted places at root level."},"position":{"type":"integer","minimum":0,"description":"Position among siblings (0-indexed). Omit to place at end."}},"required":["project_id","title","description"]}}}",
