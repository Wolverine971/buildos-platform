      "serialized": "{"type":"function","function":{"name":"declare_read_only_turn","description":"Declare that this turn requires no durable change. Research, comparison, analysis, and advice are read-only when they only inform a possible later change. Never use this to replace a commissioned action.","parameters":{"type":"object","properties":{"reason":{"type":"string","maxLength":240,"description":"Why no durable mutation is requested."}},"required":["reason"]}}}",
