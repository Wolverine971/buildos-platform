# apps/mobile/.env.example — copy to .env.local (gitignored). Expo inlines EXPO_PUBLIC_* only.
# The same Supabase project the web app uses: PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY in apps/web/.env
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_legacy_anon_key
# Where the BuildOS API lives. Production is https://build-os.com. For a local web dev server use
# your laptop's LAN address (the phone cannot reach localhost): http://192.168.1.20:5173
EXPO_PUBLIC_API_URL=https://build-os.com
